---
/* HERO — v2, the O is the engine. See HERO_CHOREOGRAPHY.md.
  Behaviour is in /public/scripts/home-hero-and-sections.js -- the sequence
  drives #room/#work/#mark* etc, all inside this component's own markup. */
---
<section class="hero g-ink" id="hero">
  <div class="stage">

    <div class="room" id="room"><!-- planes injected --></div>
    <div class="work" id="work"><!-- work injected --></div>

    <div class="core">
      <div class="mark" id="mark">
        <div class="mark__bloom" id="markBloom" aria-hidden="true"></div>

        <!-- the ONLY layer in the a11y tree -->
        <h1 class="mark__layer mark__layer--base" id="markBase"><span class="mark__ln">THE</span><span class="mark__ln">GL<span class="mark__o" id="markO">O</span>W</span><span class="mark__ln">TRIBE</span></h1>

        <!-- beat 4: uncovered from the O outward -->
        <div class="mark__layer mark__layer--reveal" id="markReveal" aria-hidden="true"><span class="mark__ln">THE</span><span class="mark__ln">GLOW</span><span class="mark__ln">TRIBE</span></div>

        <!-- beat 4b: the hot front riding the light's leading edge -->
        <div class="mark__layer mark__layer--front" id="markFront" aria-hidden="true"><span class="mark__ln">THE</span><span class="mark__ln">GLOW</span><span class="mark__ln">TRIBE</span></div>

        <!-- beat 5: one sweep -->
        <div class="mark__shine" id="markShine" aria-hidden="true"><span class="mark__ln">THE</span><span class="mark__ln">GLOW</span><span class="mark__ln">TRIBE</span></div>
      </div>

      <!-- 2 Nov, client note: the facts/countdown/"Save a chair" card that
           used to sit under the mark is GONE -- "so now its just the hero".
           Everything it carried now arrives as the flyer promo that eases in
           once you leave the hero (FlyerPromo.astro), so the ask is made
           once, deliberately, instead of competing with the wordmark for the
           first screen. The mark now simply holds dead centre and fades;
           home-hero-and-sections.js no longer has a group to lift it off. -->
    </div>

    <div class="cue" id="cue">Scroll</div>
  </div>
</section>
