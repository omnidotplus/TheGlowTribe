---
/* SELECTED WORK — a continuous marquee (client, 15 Sept), not swipe-driven. */
---
<section class="teaser g-paper" id="teaser" data-fade>
  <div class="teaser__head">
    <p class="eyebrow" style="margin:0">Selected work</p>
    <a class="teaser__all" href="#">All projects →</a>
  </div>
  <!-- Slides continuously (client, 15 Sept). One track, duplicated once, and
       the whole row translated by exactly -50%: the seam lands where the copy
       begins, so there isn't one. The duplicate is aria-hidden, or the four
       projects would be announced twice. -->
  <div class="teaser__row" id="teaserRow">
    <div class="teaser__track">
      <figure class="teaser__item" data-cat="music"><div class="slot" data-placeholder="P4"><img src="/img/teaser-music.webp" alt="" loading="lazy" decoding="async"></div>
        <figcaption><b class="teaser__cat">Music</b> · <span>Project title</span></figcaption></figure>
      <figure class="teaser__item" data-cat="film"><div class="slot" data-placeholder="P4"><img src="/img/teaser-film.webp" alt="" loading="lazy" decoding="async"></div>
        <figcaption><b class="teaser__cat">Film</b> · <span>Short film title</span></figcaption></figure>
      <figure class="teaser__item" data-cat="hangouts"><div class="slot" data-placeholder="P4"><img src="/img/teaser-hangouts.webp" alt="" loading="lazy" decoding="async"></div>
        <figcaption><b class="teaser__cat">Hangouts</b> · <span>Session name</span></figcaption></figure>
      <figure class="teaser__item" data-cat="music"><div class="slot" data-placeholder="P4"><img src="/img/teaser-music2.webp" alt="" loading="lazy" decoding="async"></div>
        <figcaption><b class="teaser__cat">Music</b> · <span>Project title</span></figcaption></figure>
    </div>
    <div class="teaser__track" aria-hidden="true">
      <figure class="teaser__item" data-cat="music"><div class="slot" data-placeholder="P4"><img src="/img/teaser-music.webp" alt="" loading="lazy" decoding="async"></div>
        <figcaption><b class="teaser__cat">Music</b> · <span>Project title</span></figcaption></figure>
      <figure class="teaser__item" data-cat="film"><div class="slot" data-placeholder="P4"><img src="/img/teaser-film.webp" alt="" loading="lazy" decoding="async"></div>
        <figcaption><b class="teaser__cat">Film</b> · <span>Short film title</span></figcaption></figure>
      <figure class="teaser__item" data-cat="hangouts"><div class="slot" data-placeholder="P4"><img src="/img/teaser-hangouts.webp" alt="" loading="lazy" decoding="async"></div>
        <figcaption><b class="teaser__cat">Hangouts</b> · <span>Session name</span></figcaption></figure>
      <figure class="teaser__item" data-cat="music"><div class="slot" data-placeholder="P4"><img src="/img/teaser-music2.webp" alt="" loading="lazy" decoding="async"></div>
        <figcaption><b class="teaser__cat">Music</b> · <span>Project title</span></figcaption></figure>
    </div>
  </div>
</section>
