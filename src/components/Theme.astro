---
/* THEME — andre-candido proportions, carried from home.html unchanged. */
---
<section class="theme g-ink" id="theme" data-fade>
  <div class="theme__grid">
    <div class="theme__main">
      <p class="eyebrow">The theme</p>
      <h2 class="theme__statement">
        You are the light of the world. A town built on a hill
        cannot be hidden.
      </h2>
      <p class="theme__ref">Matthew 5:14</p>
    </div>

    <!-- N1 · the grid-break. andre-candido places an illustration slightly BELOW
         its statement block, overlapping the section's lower edge so the rigid
         grid is broken once. Here it is a cast-light shape — a hard-edged
         parallelogram, as light falls through a doorway — NOT a circle, because
         the conference hero already owned discs and a second round form on the
         same page would read as a tic. Occlusion and projection are light
         behaviours, so this stays on the B6a physics guardrail. -->
    <figure class="theme__cast">
      <img src="/img/theme-cast.webp" alt="" loading="lazy" decoding="async">
      <figcaption class="theme__castCap">A light that is not hidden</figcaption>
    </figure>

    <aside class="theme__aside">
      <p class="theme__asideHead">Who it's for <span aria-hidden="true">↓</span></p>
      <ul class="theme__list">
        <li>Musicians</li><li>Filmmakers</li><li>Writers</li>
        <li>Photographers</li><li>Designers</li><li>Producers</li>
        <li>Anyone making something</li>
      </ul>
    </aside>
  </div>
</section>
