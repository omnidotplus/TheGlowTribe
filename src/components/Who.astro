---
/* WHO WE ARE — scroll-scrubbed typewriter, mechanics from newformcap.com.
  Copy is REAL (brief §4), not placeholder. */
---
<section class="who g-dark" id="who" data-fade>
  <div class="who__stage">

    <!-- rotated rail, far-left margin -->

    <!-- the tall portrait plate. The headline crosses OVER its right edge —
         that overlap is the composition's central idea. Plates trade sides
         and stagger in depth as you travel. -->
    <div class="who__well" id="whoWell">
      <div class="slot who__plate" data-i="0" data-state="in"  data-placeholder="P4"><img src="/img/who-01.webp" alt=""></div>
      <div class="slot who__plate" data-i="1" data-state="below" data-placeholder="P4"><img src="/img/who-02.webp" alt=""></div>
      <div class="slot who__plate" data-i="2" data-state="below" data-placeholder="P4"><img src="/img/who-03.webp" alt=""></div>
    </div>

    <!-- "coming up next": the faded TOP EDGE of the following image, set down
         and to the RIGHT of the well so the two read as a diagonal queue
         rather than a vertical stack (client, 15 Sept). It is a peek, not a
         thumbnail — the bottom is masked away so it reads as an image still
         arriving. -->
    <div class="who__next" id="whoNext" aria-hidden="true">
      <img src="/img/who-02.webp" alt="">
    </div>

    <div class="who__inner">
      <div class="who__lines">
        <span class="who__line" data-line="0"></span>
        <span class="who__line" data-line="1"></span>
        <span class="who__line" data-line="2"></span>
      </div>
    </div>

    <!-- the stable block, anchored bottom-left. Never changes while the
         statement churns — that contrast is what stops the typewriter
         reading as a gimmick. -->
    <div class="who__stable">
      <p class="who__count"><span id="whoIndex">01</span> / 03</p>
      <p class="who__label">Who we are</p>
      <p class="who__desc">A community of Christian creatives, from musicians and filmmakers
         to poets, painters and designers, making work and making space for each other to
         grow. Faith and craft, held together.</p>
      <a class="who__cta btnfx" href="#teaser"><span>See the work</span> <span aria-hidden="true">→</span></a>
    </div>

  </div>
</section>
